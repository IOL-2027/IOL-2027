API_PORT=4000
DATABASE_URL=postgres://iol2027:iol2027@localhost:5432/iol2027
UPLOAD_DIR=server/uploads
APP_ORIGIN=http://localhost:5180
NODE_ENV=development
RESEND_API_KEY=
EMAIL_FROM=IOL 2027 Registration <registration@example.org>
FINANCE_EMAIL=
EMAIL_REPLY_TO=
# Development only: return email verification codes in API responses while no email provider is set.
EXPOSE_DEV_CODES=true
# Used by npm run db:seed-test for every @iol2027.test account.
TEST_ACCOUNT_PASSWORD=
VITE_BADGE_SCANNER_MODE=demo

# Only for scripts/generate-thai-audio.py (one-off audio generation, not used at runtime)
GEMINI_API_KEY=

# Production only: private Cloud Storage bucket for uploads. Leave empty to keep files in UPLOAD_DIR.
UPLOAD_BUCKET=
