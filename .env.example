API_PORT=4000
DATABASE_URL=postgres://iol2027:iol2027@localhost:5432/iol2027
UPLOAD_DIR=server/uploads
APP_ORIGIN=http://localhost:5180,http://localhost:5181
# Where links in emails point: the registration portal (invitations, flights, receipts, staff set-up).
PORTAL_URL=http://localhost:5181
NODE_ENV=development
# Email: Gmail (used when both are set), or Resend. See docs/EMAIL_SETUP.md.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=IOL 2027 Registration <registration@example.org>
FINANCE_EMAIL=
EMAIL_REPLY_TO=
# Development only: return email verification codes in API responses while no email provider is set.
EXPOSE_DEV_CODES=true
# Derives each badge's QR secret so a QR can be drawn again (printed badges). Any long random string locally;
# without it, badges still work but their QR codes cannot be redrawn.
BADGE_SIGNING_KEY=
# Used by npm run db:seed-test for every @iol2027.test account.
TEST_ACCOUNT_PASSWORD=
# Optional: a real inbox for the demo Team Leader, so the walkthrough's emails arrive (default demo.leader@iol2027.test).
DEMO_LEADER_EMAIL=
# How the website and the registration portal link to each other (the deploy workflows set the real addresses).
VITE_PUBLIC_SITE_URL=http://localhost:5180
VITE_PORTAL_URL=http://localhost:5181
# false keeps registration closed: no portal link on the website, and the portal only says when it opens
# (the public sites build with false until 18 January 2027). Leave empty for open.
VITE_REGISTRATION_OPEN=
# false hides Gallery, People and Sponsors (the public site builds with false until launch). Leave empty to show them.
VITE_SHOW_PLACEHOLDER_PAGES=

# Only for scripts/generate-thai-audio.py (one-off audio generation, not used at runtime)
GEMINI_API_KEY=

# Production only: private Cloud Storage bucket for uploads. Leave empty to keep files in UPLOAD_DIR.
UPLOAD_BUCKET=
