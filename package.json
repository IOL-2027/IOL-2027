{
  "name": "iol-2027-thailand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "start:api": "node server/index.js",
    "db:schema": "psql \"$DATABASE_URL\" -f server/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f server/seed.sql",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "db:migrate": "node server/migrate.js",
    "db:seed-test": "node server/seed-test.js",
    "test:api": "node server/test/api-e2e.mjs",
    "dev:portal": "vite --config vite.portal.config.ts --host 0.0.0.0",
    "build:portal": "tsc -b && vite build --config vite.portal.config.ts",
    "preview:portal": "vite preview --config vite.portal.config.ts --host 0.0.0.0"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fontkit": "^2.0.4",
    "google-auth-library": "^9.15.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "latest",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
